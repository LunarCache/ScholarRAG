# Parsing APIs
MINERU_API_TOKEN=
PADDLEOCR_ACCESS_TOKEN=

# SiliconFlow OpenAI-compatible APIs
SILICONFLOW_API_KEY=
# Optional for a remotely exposed personal deployment. Leave unset for localhost-only use.
SCHOLARRAG_API_BEARER_TOKEN=
# local: legacy local reading/query; session: workspace APIs and unified upload queue.
SCHOLARRAG_AUTH_MODE=local
# JSON array of exact browser origins; add the deployed Web origin here.
SCHOLARRAG_API_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
SCHOLARRAG_AUTHORIZATION_POLL_SECONDS=1
SCHOLARRAG_WORKSPACE_QUERY_MAX_ACTIVE=16
SCHOLARRAG_WORKSPACE_QUERY_MAX_PER_USER=4
# Queued + parsing tasks per workspace, and per user within that workspace.
SCHOLARRAG_WORKSPACE_INGESTION_MAX_ACTIVE=64
SCHOLARRAG_WORKSPACE_INGESTION_MAX_PER_USER=8
SCHOLARRAG_API_REQUESTS_PER_MINUTE=240
# Upload validation before parser jobs (also set proxy request/body limits).
SCHOLARRAG_UPLOAD_MAX_BYTES=52428800
SCHOLARRAG_UPLOAD_MAX_PAGES=500
# Shared capacity across SiliconFlow clients within one event loop/process.
SCHOLARRAG_PROVIDER_MAX_CONCURRENCY=8
SCHOLARRAG_PROVIDER_QUEUE_TIMEOUT_SECONDS=30
# 可选：按硅基流动当前价格填写，避免在代码中固化易变化的价格
SCHOLARRAG_CHAT_INPUT_CNY_PER_MILLION_TOKENS=0
SCHOLARRAG_CHAT_OUTPUT_CNY_PER_MILLION_TOKENS=0

# Optional overrides
SCHOLARRAG_DATA_DIR=./data
SCHOLARRAG_EVALS_DIR=./evals
SCHOLARRAG_MINERU_MODEL=vlm
# Hosted cloud API v4 (not the self-hosted MinerU 4.x /v1 service).
SCHOLARRAG_MINERU_BASE_URL=https://mineru.net/api/v4
SCHOLARRAG_MINERU_LANGUAGE=en
SCHOLARRAG_MINERU_IS_OCR=false
SCHOLARRAG_PADDLE_MODEL=PaddleOCR-VL-1.6
SCHOLARRAG_PARSE_QUALITY_MODE=audit
SCHOLARRAG_PARSE_QUALITY_ACCEPT_SCORE=0.85
SCHOLARRAG_PARSE_QUALITY_REVIEW_SCORE=0.65
SCHOLARRAG_PARSE_FALLBACK_MODE=on_review
SCHOLARRAG_PARSE_ROUTE_MIN_SCORE_IMPROVEMENT=0.03
SCHOLARRAG_EMBEDDING_MODEL=Qwen/Qwen3-VL-Embedding-8B
SCHOLARRAG_MULTIMODAL_EMBEDDING_MODEL=Qwen/Qwen3-VL-Embedding-8B
SCHOLARRAG_EMBEDDING_DIMENSIONS=1024
SCHOLARRAG_RERANK_MODEL=Qwen/Qwen3-VL-Reranker-8B
SCHOLARRAG_CHAT_MODEL=Qwen/Qwen3.6-27B
SCHOLARRAG_CHAT_ENABLE_THINKING=true
SCHOLARRAG_RAGAS_JUDGE_MODEL=Qwen/Qwen3.6-27B
SCHOLARRAG_RAGAS_JUDGE_CONTEXT_WINDOW_TOKENS=262144
SCHOLARRAG_RAGAS_JUDGE_ENABLE_THINKING=true

# Optional Langfuse tracing (install: uv sync --extra observability)
# Copy the base URL and project keys from your Langfuse project settings.
SCHOLARRAG_LANGFUSE_ENABLED=false
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
SCHOLARRAG_LANGFUSE_ENVIRONMENT=development
# Opt in to sending question/answer/context text; images and reasoning are omitted.
SCHOLARRAG_LANGFUSE_CAPTURE_CONTENT=false
